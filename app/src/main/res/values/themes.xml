<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The player: dark Material 3, an amber accent (an "instrument panel" look), no action bar. -->
    <style name="Theme.VstGhost" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/vg_amber</item>
        <item name="colorOnPrimary">@color/vg_ink</item>
        <item name="colorPrimaryContainer">@color/vg_amber_dim</item>
        <item name="colorOnPrimaryContainer">@color/vg_amber_text</item>
        <item name="colorSecondary">@color/vg_teal</item>
        <item name="colorOnSecondary">@color/vg_ink</item>
        <item name="colorSecondaryContainer">@color/vg_teal_dim</item>
        <item name="colorOnSecondaryContainer">@color/vg_teal_text</item>
        <item name="colorSurface">@color/vg_surface</item>
        <item name="colorSurfaceVariant">@color/vg_surface_2</item>
        <item name="colorSurfaceContainer">@color/vg_surface_2</item>
        <item name="colorSurfaceContainerHigh">@color/vg_surface_3</item>
        <item name="colorOnSurface">@color/vg_text</item>
        <item name="colorOnSurfaceVariant">@color/vg_text_dim</item>
        <item name="colorOutline">@color/vg_outline</item>
        <item name="colorError">@color/vg_red</item>
        <item name="android:windowBackground">@color/vg_bg</item>
        <item name="android:statusBarColor">@color/vg_bg</item>
        <item name="android:navigationBarColor">@color/vg_bg</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.VstGhost.Dialog</item>
    </style>

    <style name="ThemeOverlay.VstGhost.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/vg_surface_2</item>
    </style>

    <!-- Compact buttons for the top bar. -->
    <style name="Widget.VstGhost.Button" parent="Widget.Material3.Button.TonalButton">
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">38dp</item>
        <item name="android:insetTop">2dp</item>
        <item name="android:insetBottom">2dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
    </style>
    <style name="Widget.VstGhost.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">38dp</item>
        <item name="android:insetTop">2dp</item>
        <item name="android:insetBottom">2dp</item>
    </style>
    <style name="Widget.VstGhost.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">38dp</item>
        <item name="android:insetTop">2dp</item>
        <item name="android:insetBottom">2dp</item>
    </style>
    <!-- A slot in the Instruments / Effects strip: outlined, checked = selected. -->
    <style name="Widget.VstGhost.Slot" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textSize">12sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:insetTop">1dp</item>
        <item name="android:insetBottom">1dp</item>
        <item name="android:paddingLeft">8dp</item>
        <item name="android:paddingRight">8dp</item>
        <item name="android:checkable">true</item>
        <item name="strokeColor">@color/vg_outline</item>
    </style>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.software.midi" android:required="false" />
    <uses-feature android:name="android.hardware.audio.low_latency" android:required="false" />
    <!-- "Install plugin": browse Download/Documents/SD cards for .vst3 and zips (All files access;
         READ_EXTERNAL_STORAGE on Android 10-12). -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <!-- Background playing: a media-playback foreground service while a plugin is loaded. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".VstGhostApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.DeviceDefault"
        android:largeHeap="true">

        <!-- The player (Phase 2). -->
        <activity
            android:name=".PlayerActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.VstGhost"
            android:windowSoftInputMode="adjustPan">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- A plugin's own editor (Phase 4); exported so it can be opened over adb for tests. -->
        <activity
            android:name=".EditorActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />

        <!-- A native plugin's own editor (Phase 5). -->
        <activity
            android:name=".NativeEditorActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:windowSoftInputMode="adjustResize"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />

        <!-- Test harness (Phase 0-2 reports); also driven by adb autorun. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop" />

        <activity android:name=".AboutActivity" android:exported="false" android:theme="@style/Theme.VstGhost"
            android:label="About VST gHost" />

        <!-- Problem reports are zipped into the cache folder and handed to the share sheet. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <!-- Keeps the engine alive in the background while a plugin is loaded (notification with Stop). -->
        <service
            android:name=".PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Phase 3: the bridge slots as AAP plugins (service implementation from the AAP library). -->
        <service
            android:name="org.androidaudioplugin.AudioPluginService"
            android:exported="true"
            android:label="VST gHost"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="org.androidaudioplugin.AudioPluginService.V4" />
            </intent-filter>
            <meta-data
                android:name="org.androidaudioplugin.AudioPluginService.V4#Plugins"
                android:resource="@xml/aap_metadata" />
        </service>

        <!-- Phase 3: one virtual MIDI device per instrument slot. -->
        <service android:name=".MidiSlot1Service" android:exported="true"
            android:permission="android.permission.BIND_MIDI_DEVICE_SERVICE">
            <intent-filter><action android:name="android.media.midi.MidiDeviceService" /></intent-filter>
            <meta-data android:name="android.media.midi.MidiDeviceService" android:resource="@xml/midi_slot1" />
        </service>
        <service android:name=".MidiSlot2Service" android:exported="true"
            android:permission="android.permission.BIND_MIDI_DEVICE_SERVICE">
            <intent-filter><action android:name="android.media.midi.MidiDeviceService" /></intent-filter>
            <meta-data android:name="android.media.midi.MidiDeviceService" android:resource="@xml/midi_slot2" />
        </service>
        <service android:name=".MidiSlot3Service" android:exported="true"
            android:permission="android.permission.BIND_MIDI_DEVICE_SERVICE">
            <intent-filter><action android:name="android.media.midi.MidiDeviceService" /></intent-filter>
            <meta-data android:name="android.media.midi.MidiDeviceService" android:resource="@xml/midi_slot3" />
        </service>
        <service android:name=".MidiSlot4Service" android:exported="true"
            android:permission="android.permission.BIND_MIDI_DEVICE_SERVICE">
            <intent-filter><action android:name="android.media.midi.MidiDeviceService" /></intent-filter>
            <meta-data android:name="android.media.midi.MidiDeviceService" android:resource="@xml/midi_slot4" />
        </service>
    </application>
</manifest>

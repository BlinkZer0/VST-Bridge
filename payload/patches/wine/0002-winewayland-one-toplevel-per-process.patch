--- a/dlls/winewayland.drv/window.c	2026-11-18 11:52:20.008198140 -0600
+++ b/dlls/winewayland.drv/window.c	2026-11-18 11:52:20.008977266 -0600
@@ -433,6 +433,33 @@
     return TRUE;
 }
 
+/* VST gHost: when VSTGHOST_WL_ONE_TOPLEVEL=1, the process's editor window (class
+ * "VstGhostEditor-<pid>") is its only Wayland toplevel; every other visible window of the
+ * process (menus, dialogs, tooltips) becomes a subsurface of it at its Windows position, so a
+ * minimal compositor can show the editor and its popups as one picture. */
+static HWND vstghost_main_window(void)
+{
+    static int enabled = -1;
+    char buf[64];
+    WCHAR name[64];
+    UNICODE_STRING us;
+    int i;
+
+    if (enabled < 0)
+    {
+        const char *e = getenv("VSTGHOST_WL_ONE_TOPLEVEL");
+        enabled = e && e[0] == '1';
+    }
+    if (!enabled) return 0;
+    snprintf(buf, sizeof(buf), "VstGhostEditor-%u", (unsigned int)(UINT_PTR)NtCurrentTeb()->ClientId.UniqueProcess);
+    for (i = 0; buf[i]; i++) name[i] = buf[i];
+    name[i] = 0;
+    us.Buffer = name;
+    us.Length = i * sizeof(WCHAR);
+    us.MaximumLength = sizeof(name);
+    return NtUserFindWindowEx(0, 0, &us, NULL, 0);
+}
+
 /***********************************************************************
  *           WAYLAND_WindowPosChanged
  */
@@ -450,7 +477,15 @@
     /* Get the managed state with win_data unlocked, as is_window_managed
      * may need to query win_data information about other HWNDs and thus
      * acquire the lock itself internally. */
-    if (!(managed = is_window_managed(hwnd, swp_flags, fullscreen)) && surface) toplevel = owner_hint;
+    HWND vstghost_main = vstghost_main_window();
+
+    managed = is_window_managed(hwnd, swp_flags, fullscreen);
+    if (vstghost_main && hwnd != vstghost_main)
+    {
+        managed = FALSE;
+        owner_hint = vstghost_main;
+    }
+    if (!managed && surface) toplevel = owner_hint;
 
     if (!(data = wayland_win_data_get(hwnd))) return;
     toplevel_data = toplevel && toplevel != hwnd ? wayland_win_data_get_nolock(toplevel) : NULL;

+static void set_swapchain_window(IUnknown *content, HWND hwnd)
+{
+    IDXGISwapChain1 *swapchain;
+
+    if (!content || FAILED(IUnknown_QueryInterface(content, &IID_IDXGISwapChain1, (void **)&swapchain)))
+        return;
+    IDXGISwapChain1_SetPrivateData(swapchain, &wine_dcomp_target_window_guid, hwnd ? sizeof(hwnd) : 0, hwnd ? &hwnd : NULL);
+    IDXGISwapChain1_Release(swapchain);
+}

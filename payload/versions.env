# Pinned inputs for the Wine/Box64 payload. Every download is checked against its SHA-256.
# Change a version here, update the hash, rebuild. (Checked 2026-11-18.)

PAYLOAD_SERIES=2

# Box64 (MIT): https://github.com/ptitSeb/box64
BOX64_VERSION=0.4.4
BOX64_URL=https://github.com/ptitSeb/box64/archive/refs/tags/v0.4.4.tar.gz
BOX64_SHA256=99c6de4f509e46ab1de15df740d0e0ea338a7790efa3f67510dfbb975cc24029
# Snapdragon 8 Elite Gen 5 tuning target (Galaxy S26 Ultra). Box64 option, see its CMakeLists.txt.
BOX64_CPU_FLAG=-DSD8EG5=1

# Wine (LGPL-2.1+): stable 11.0
WINE_VERSION=11.0
WINE_URL=https://dl.winehq.org/wine/source/11.0/wine-11.0.tar.xz
WINE_SHA256=c07a6857933c1fc60dff5448d79f39c92481c1e9db5aa628db9d0358446e0701

# VST3 pluginterfaces (MIT): headers only, used by the bridge host
VST3PI_VERSION=v3.8.1_build_84
VST3PI_URL=https://github.com/steinbergmedia/vst3_pluginterfaces/archive/refs/tags/v3.8.1_build_84.tar.gz
VST3PI_SHA256=19e88e225b6ecb4a3c429d3ff2fd511be9c6c8b8b1c7e86b05949b45c0553e2d

# arm64 glibc patched for Android, prebuilt by Termux-pacman (gpkg repo).
# The repo only keeps current versions; if these 404, mirror or bump.
# From source instead (release builds): payload/build-glibc-src.sh builds the same packages with
# Termux-pacman's pinned recipe; then export TERMUX_GLIBC_LOCAL=<glibc-….pkg.tar.xz>
# TERMUX_GCCLIBS_LOCAL=<gcc-libs-glibc-….pkg.tar.xz> before `payload/build.sh glibc …`.
TERMUX_GPKG_REPO=https://sync.termux-pacman.dev/gpkg/aarch64
TERMUX_GLIBC_FILE=glibc-2.44-0-aarch64.pkg.tar.xz
TERMUX_GLIBC_SHA256=8725a20d85fa35a094cf092286295668fd5292247128c4bb8101585ba063799c
TERMUX_GCCLIBS_FILE=gcc-libs-glibc-14.2.1-1-aarch64.pkg.tar.xz
TERMUX_GCCLIBS_SHA256=9316728ceeb23c320756aa0bb03460f9767b6efdc44a478c86f7fcc44c6e11ec

# Mesa (MIT): software OpenGL/EGL for plugin editors that draw with OpenGL (Phase 5).
MESA_VERSION=25.0.7
MESA_URL=https://archive.mesa3d.org/mesa-25.0.7.tar.xz
MESA_SHA256=592272df3cf01e85e7db300c449df5061092574d099da275d19e97ef0510f8a6

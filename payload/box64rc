# VST gHost Box64 settings (BOX64_RCFILE). Per-executable sections override [*].
# Phase 0 runs Box64 defaults on purpose; every tweak added later must come with a measured A/B.

[*]
BOX64_LOG=1

# Phase 2+: the bridge host shares lock-free ring buffers with arm64 code. x86 relies on TSO
# ordering; translated code does not have it, so the host gets strong memory emulation.
# [vstghost-host.exe]
# BOX64_DYNAREC_STRONGMEM=1

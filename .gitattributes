# Auto detect text files and perform LF normalization
* text=auto

# Files used inside Linux (WSL/Docker) must keep LF even with core.autocrlf=true.
*.sh        text eol=lf
*.patch     text eol=lf
*.env       text eol=lf
Dockerfile  text eol=lf
payload/box64rc text eol=lf
gradlew     text eol=lf
*.bat       text eol=crlf
*.jar       binary

#
# Projucer projects (.jucer) in the adapter. A .jucer file is XML; the parts a plugin build needs
# are read with regular expressions (no XML parser in CMake) and turned into the same calls a
# JUCE CMake project would make: juce_add_plugin(), juce_add_binary_data(), target_sources(),
# compile definitions, module links and JuceHeader.h.
#
#   vg_add_jucer_plugin(<target> <path/to/project.jucer>)
#
# Read: <JUCERPROJECT …> attributes (names, codes, version, synth/MIDI flags, defines),
# <MODULE id=…> + <MODULEPATH id=… path=…> (JUCE modules by name; other modules from their path),
# <JUCEOPTIONS …> (module config flags → compile definitions), <FILE … compile="1"> (sources),
# <FILE … resource="1"> (binary data), headerPath / extraDefs of the first <CONFIGURATION>.
# Not read: exporter-specific settings, post-export shell commands, ARA/AAX fields.

function(_vg_jucer_attr out xml tag attr)
    string(REGEX MATCH "<${tag}[^>]*[ \t\r\n]${attr}=\"([^\"]*)\"" _m "${xml}")
    if(_m)
        set(${out} "${CMAKE_MATCH_1}" PARENT_SCOPE)
    else()
        set(${out} "" PARENT_SCOPE)
    endif()
endfunction()

function(vg_add_jucer_plugin target jucer)
    get_filename_component(jucer "${jucer}" ABSOLUTE)
    get_filename_component(projdir "${jucer}" DIRECTORY)
    file(READ "${jucer}" xml)

    _vg_jucer_attr(pname "${xml}" JUCERPROJECT pluginName)
    _vg_jucer_attr(name "${xml}" JUCERPROJECT name)
    if(NOT pname)
        set(pname "${name}")
    endif()
    _vg_jucer_attr(company "${xml}" JUCERPROJECT pluginManufacturer)
    if(NOT company)
        _vg_jucer_attr(company "${xml}" JUCERPROJECT companyName)
    endif()
    _vg_jucer_attr(mfr "${xml}" JUCERPROJECT pluginManufacturerCode)
    _vg_jucer_attr(code "${xml}" JUCERPROJECT pluginCode)
    _vg_jucer_attr(version "${xml}" JUCERPROJECT version)
    _vg_jucer_attr(desc "${xml}" JUCERPROJECT pluginDesc)
    _vg_jucer_attr(synth "${xml}" JUCERPROJECT pluginIsSynth)
    _vg_jucer_attr(midiIn "${xml}" JUCERPROJECT pluginWantsMidiIn)
    _vg_jucer_attr(midiOut "${xml}" JUCERPROJECT pluginProducesMidiOut)
    _vg_jucer_attr(midiFx "${xml}" JUCERPROJECT pluginIsMidiEffectPlugin)
    _vg_jucer_attr(kbd "${xml}" JUCERPROJECT pluginEditorRequiresKeys)
    _vg_jucer_attr(defines "${xml}" JUCERPROJECT defines)
    # Newer Projucer: pluginCharacteristicsValue="pluginIsSynth,pluginWantsMidiIn,…"
    _vg_jucer_attr(chars "${xml}" JUCERPROJECT pluginCharacteristicsValue)
    if(chars)
        if(chars MATCHES "pluginIsSynth")
            set(synth 1)
        endif()
        if(chars MATCHES "pluginWantsMidiIn")
            set(midiIn 1)
        endif()
        if(chars MATCHES "pluginProducesMidiOut")
            set(midiOut 1)
        endif()
        if(chars MATCHES "pluginIsMidiEffectPlugin")
            set(midiFx 1)
        endif()
        if(chars MATCHES "pluginEditorRequiresKeys")
            set(kbd 1)
        endif()
    endif()
    foreach(v synth midiIn midiOut midiFx kbd)
        if("${${v}}" STREQUAL "1")
            set(${v} TRUE)
        else()
            set(${v} FALSE)
        endif()
    endforeach()

    juce_add_plugin(${target}
        PRODUCT_NAME "${pname}" COMPANY_NAME "${company}" DESCRIPTION "${desc}" VERSION "${version}"
        PLUGIN_MANUFACTURER_CODE "${mfr}" PLUGIN_CODE "${code}"
        IS_SYNTH ${synth} NEEDS_MIDI_INPUT ${midiIn} NEEDS_MIDI_OUTPUT ${midiOut} IS_MIDI_EFFECT ${midiFx}
        EDITOR_WANTS_KEYBOARD_FOCUS ${kbd})

    # Sources and resources.
    string(REGEX MATCHALL "<FILE [^>]*/>" files "${xml}")
    set(srcs "")
    set(res "")
    foreach(f IN LISTS files)
        string(REGEX MATCH "file=\"([^\"]*)\"" _m "${f}")
        set(path "${CMAKE_MATCH_1}")
        if(NOT path)
            continue()
        endif()
        if(f MATCHES "compile=\"1\"" AND path MATCHES "\\.(c|cc|cpp|cxx|mm|m)$")
            list(APPEND srcs "${projdir}/${path}")
        elseif(f MATCHES "resource=\"1\"")
            list(APPEND res "${projdir}/${path}")
        endif()
    endforeach()
    if(res)
        juce_add_binary_data(${target}_BinaryData SOURCES ${res})
        target_link_libraries(${target} PRIVATE ${target}_BinaryData)
    endif()
    target_sources(${target} PRIVATE ${srcs})
    target_include_directories(${target} PRIVATE "${projdir}/Source" "${projdir}")

    # Defines: project-wide, the first configuration's, and the module options.
    set(defs "")
    foreach(d IN LISTS defines)
        string(REGEX REPLACE "[ \t\r\n]+" ";" dl "${d}")
        list(APPEND defs ${dl})
    endforeach()
    string(REGEX MATCH "<CONFIGURATION [^>]*/>" cfg "${xml}")
    if(cfg)
        string(REGEX MATCH "defines=\"([^\"]*)\"" _m "${cfg}")
        if(_m)
            string(REGEX REPLACE "[ \t\r\n]+" ";" dl "${CMAKE_MATCH_1}")
            list(APPEND defs ${dl})
        endif()
        string(REGEX MATCH "headerPath=\"([^\"]*)\"" _m "${cfg}")
        if(_m)
            string(REGEX REPLACE "[ \t\r\n;]+" ";" hp "${CMAKE_MATCH_1}")
            foreach(h IN LISTS hp)
                if(h)
                    target_include_directories(${target} PRIVATE "${projdir}/${h}")
                endif()
            endforeach()
        endif()
    endif()
    string(REGEX MATCH "<JUCEOPTIONS[^>]*/>" opts "${xml}")
    if(opts)
        string(REGEX MATCHALL "[A-Za-z0-9_]+=\"[^\"]*\"" kvs "${opts}")
        foreach(kv IN LISTS kvs)
            string(REPLACE "\"" "" kv "${kv}")
            list(APPEND defs "${kv}")
        endforeach()
    endif()
    if(defs)
        target_compile_definitions(${target} PRIVATE ${defs})
    endif()

    # Modules: JUCE's by name; others from their <MODULEPATH>.
    string(REGEX MATCHALL "<MODULE id=\"[^\"]*\"" mods "${xml}")
    string(REGEX MATCHALL "<MODULEPATH [^>]*/>" mpaths "${xml}")
    foreach(m IN LISTS mods)
        string(REGEX REPLACE "<MODULE id=\"([^\"]*)\"" "\\1" id "${m}")
        if(NOT TARGET ${id})
            foreach(mp IN LISTS mpaths)
                if(mp MATCHES "id=\"${id}\"" AND mp MATCHES "path=\"([^\"]*)\"")
                    set(mpath "${CMAKE_MATCH_1}")
                    if(EXISTS "${projdir}/${mpath}/${id}" AND NOT id MATCHES "^juce_")
                        juce_add_module("${projdir}/${mpath}/${id}")
                    endif()
                endif()
            endforeach()
        endif()
        if(TARGET ${id})
            target_link_libraries(${target} PRIVATE ${id})
        else()
            message(WARNING "VgJucer: module ${id} not found for ${target}")
        endif()
    endforeach()
    juce_generate_juce_header(${target})
    message(STATUS "VgJucer: ${target} from ${jucer}: ${pname} by ${company}, synth=${synth}")
endfunction()

#
# vg_binary_data(<target> <outdir> <headerName> <namespace> <files...>)
# Generates BinaryData.h/.cpp the way JUCE's juceaide does (same identifiers, namedResourceList,
# originalFilenames, getNamedResource...), in plain CMake, so cross-compiling for Android needs no
# host-built juceaide. Creates a static library <target> exposing the header directory.

function(_vg_binary_identifier out fileName)
    string(REGEX REPLACE "[ .]" "_" id "${fileName}")
    string(REGEX REPLACE "[^A-Za-z0-9_]" "" id "${id}")
    if(id STREQUAL "")
        set(id "unknown")
    endif()
    if(id MATCHES "^[0-9]")
        set(id "_${id}")
    endif()
    set(${out} "${id}" PARENT_SCOPE)
endfunction()

function(vg_binary_data target outdir headerName ns)
    set(files ${ARGN})
    file(MAKE_DIRECTORY "${outdir}")
    set(names "")
    set(h "/* Generated by native/cmake/vg_binary_data.cmake (juceaide-compatible). */\n#pragma once\n\nnamespace ${ns}\n{\n")
    set(cpp "/* Generated by native/cmake/vg_binary_data.cmake (juceaide-compatible). */\n#include <cstring>\n#include \"${headerName}\"\n\nnamespace ${ns}\n{\n")
    set(list "")
    set(origs "")
    set(lookup "")
    foreach(f IN LISTS files)
        get_filename_component(fn "${f}" NAME)
        _vg_binary_identifier(root "${fn}")
        set(name "${root}")
        set(suffix 2)
        while(name IN_LIST names)
            set(name "${root}${suffix}")
            math(EXPR suffix "${suffix} + 1")
        endwhile()
        list(APPEND names "${name}")
        file(READ "${f}" hex HEX)
        string(LENGTH "${hex}" hexLen)
        math(EXPR size "${hexLen} / 2")
        string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
        string(APPEND h "    extern const char*   ${name};\n    const int            ${name}Size = ${size};\n\n")
        string(APPEND cpp "static const unsigned char temp_${name}[] = {${bytes}0};\nconst char* ${name} = (const char*) temp_${name};\n\n")
        string(APPEND list "    \"${name}\",\n")
        string(APPEND origs "    \"${fn}\",\n")
        string(APPEND lookup "    if (strcmp (resourceNameUTF8, \"${name}\") == 0) { numBytes = ${size}; return ${name}; }\n")
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${f}")
    endforeach()
    list(LENGTH files count)
    string(APPEND h "    const int namedResourceListSize = ${count};\n    extern const char* namedResourceList[];\n    extern const char* originalFilenames[];\n")
    string(APPEND h "    const char* getNamedResource (const char* resourceNameUTF8, int& dataSizeInBytes);\n")
    string(APPEND h "    const char* getNamedResourceOriginalFilename (const char* resourceNameUTF8);\n}\n")
    string(APPEND cpp "const char* getNamedResource (const char* resourceNameUTF8, int& numBytes)\n{\n${lookup}    numBytes = 0;\n    return nullptr;\n}\n\n")
    string(APPEND cpp "const char* namedResourceList[] =\n{\n${list}};\n\nconst char* originalFilenames[] =\n{\n${origs}};\n\n")
    string(APPEND cpp "const char* getNamedResourceOriginalFilename (const char* resourceNameUTF8)\n{\n")
    string(APPEND cpp "    for (unsigned int i = 0; i < (sizeof (namedResourceList) / sizeof (namedResourceList[0])); ++i)\n")
    string(APPEND cpp "        if (strcmp (namedResourceList[i], resourceNameUTF8) == 0)\n            return originalFilenames[i];\n    return nullptr;\n}\n\n}\n")
    # Only rewrite when changed, so builds stay incremental.
    get_filename_component(cppName "${headerName}" NAME_WE)
    foreach(pair "${headerName};h" "${cppName}.cpp;cpp")
        list(GET pair 0 fname)
        list(GET pair 1 var)
        set(path "${outdir}/${fname}")
        set(old "")
        if(EXISTS "${path}")
            file(READ "${path}" old)
        endif()
        if(NOT old STREQUAL "${${var}}")
            file(WRITE "${path}" "${${var}}")
        endif()
    endforeach()
    add_library(${target} STATIC "${outdir}/${cppName}.cpp")
    target_include_directories(${target} PUBLIC "${outdir}")
endfunction()
